{
    "name": "heroshots/sdk",
    "description": "Official PHP SDK for the HeroShots / StudioHero platform (JWT auth).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "HeroShots\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HeroShots\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
